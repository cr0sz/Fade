# ============================================================
# Fade — Environment Configuration
#
# SETUP:
#   cp .env.example .env
#   # Edit .env and fill every value marked REQUIRED
#   make preflight   ← validates before first start
#   make up
#
# Variables marked [REQUIRED] will cause "make up" to abort
# with a clear error if they are missing or still placeholder.
# ============================================================

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=Fade
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# ─── Dashboard ────────────────────────────────────────────────────────────────
# [REQUIRED] to read /api/v1/dashboard/* — the API fails closed (401) without it.
# Generate one with: openssl rand -hex 32
DASHBOARD_TOKEN=CHANGE_ME_DASHBOARD_TOKEN

# Set to bind services (dashboard, miniflux, qdrant, homepage) on a specific
# interface instead of only 127.0.0.1 — e.g. a Tailscale/VPN IP for remote
# access without exposing anything to the public internet. Leave unset for
# localhost-only (default, recommended unless you know you need this).
# BIND_HOST=127.0.0.1

# ─── Trading Safety Layer  [REQUIRED before live trading] ─────────────────────
# TRADING_MODE: 'paper' (safe, default) or 'live' (real money — see below)
TRADING_MODE=paper
# Required when TRADING_MODE=live:
#   MAX_DAILY_LOSS  — maximum drawdown in USD before the engine halts (default: $50)
#   Kill switch is set via Redis: redis-cli SET trading:kill_switch 1
MAX_DAILY_LOSS=50

# ─── Binance (Crypto live trading) ────────────────────────────────────────────
# Create API keys at: https://www.binance.com/en/my/settings/api-management
# BINANCE_TESTNET=true uses https://testnet.binance.vision (safe default)
# Set BINANCE_TESTNET=false only when ready for real money
BINANCE_API_KEY=YOUR_BINANCE_API_KEY_HERE
BINANCE_API_SECRET=YOUR_BINANCE_API_SECRET_HERE
BINANCE_TESTNET=true

# ─── Alpaca (US Equities live trading) ────────────────────────────────────────
# Paper trading (free): https://app.alpaca.markets/paper-trading/overview
# Live trading: https://app.alpaca.markets/brokerage/dashboard/overview
# ALPACA_BASE_URL=https://paper-api.alpaca.markets   ← paper (safe default)
# ALPACA_BASE_URL=https://api.alpaca.markets         ← live (real money)
ALPACA_API_KEY=YOUR_ALPACA_API_KEY_HERE
ALPACA_API_SECRET=YOUR_ALPACA_API_SECRET_HERE
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mktintel
POSTGRES_USER=mktintel
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD     # [REQUIRED] — must not be blank or placeholder

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ─── Cost Control ────────────────────────────────────────────────────────────
# Maximum daily AI API spend in USD
DAILY_BUDGET_USD=5.00

# ─── AI Providers ─────────────────────────────────────────────────────────────
# OpenAI (PRIMARY — REQUIRED for full functionality)
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude (FALLBACK — optional but recommended)
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ─── Market Data Providers ───────────────────────────────────────────────────
# Polygon.io — US equities data
# Free tier: https://polygon.io/dashboard/signup
POLYGON_API_KEY=your_polygon_key_here

# Finnhub — quotes + macro indicators (BIST supported)
# Free tier: https://finnhub.io/register
FINNHUB_API_KEY=YOUR_FINNHUB_API_KEY_HERE

# Alpha Vantage — fallback (25 calls/day free)
# Get key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=YOUR_ALPHA_VANTAGE_KEY_HERE

# ─── News Providers ───────────────────────────────────────────────────────────
# NewsAPI — global news aggregator
# Free tier: https://newsapi.org/register
NEWSAPI_KEY=YOUR_NEWSAPI_KEY_HERE

# Bloomberg Enterprise (optional — RSS feeds work without a key)
# Enterprise key unlocks BLPAPI (follow runbook add_news_source.md to implement)
BLOOMBERG_API_KEY=

# Financial Times — RSS (no key required, feeds are public)
# Overriding the feeds list is optional (default is set in config.py)
# FT_RSS_FEEDS=https://www.ft.com/rss/home,https://www.ft.com/markets?format=rss

# CNBC — RSS (no key required)
# CNBC_RSS_FEEDS=https://www.cnbc.com/id/100003114/device/rss/rss.html

# Reuters (optional)
REUTERS_API_KEY=

# ─── Hybrid Deduplication ────────────────────────────────────────────────────
# Enable Level-3 semantic dedup (uses OpenAI embeddings — small cost)
# Requires OPENAI_API_KEY to be set. Costs ~$0.00002 per 1k tokens.
DEDUP_USE_EMBEDDINGS=false
DEDUP_SEMANTIC_THRESHOLD=0.92

# ─── Circuit Breaker ──────────────────────────────────────────────────────────
# How many consecutive failures before a provider circuit opens
CIRCUIT_FAILURE_THRESHOLD=5
# Seconds before a tripped circuit enters half-open (recovery probe)
CIRCUIT_RECOVERY_TIMEOUT=60.0

# ─── Social Media Providers ──────────────────────────────────────────────────
# Reddit API — create app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=MarketIntelBot/0.1 by YourUsername

# X / Twitter API v2 — https://developer.twitter.com/
TWITTER_BEARER_TOKEN=your_twitter_bearer_token
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ─── Smart Money Providers ────────────────────────────────────────────────────
# Whale Alert — large crypto/DeFi transactions
# Free tier: https://whale-alert.io/
WHALE_ALERT_API_KEY=your_whale_alert_key

# SEC EDGAR — no key required (public API)
# User-agent required per SEC policy
SEC_EDGAR_USER_AGENT=MarketIntel contact@yourdomain.com

# ─── Discord Bot (REQUIRED for slash commands) ────────────────────────────────
# Create bot at https://discord.com/developers/applications → Bot → Token
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE
# Right-click your server → Copy Server ID (Enable Developer Mode first)
DISCORD_GUILD_ID=YOUR_DISCORD_SERVER_ID_HERE
# Your personal Discord user ID (right-click yourself → Copy User ID)
DISCORD_ADMIN_USER_ID=YOUR_DISCORD_USER_ID_HERE

# ─── Scheduler Intervals (seconds) ──────────────────────────────────────────
SCHEDULER_NEWS_INTERVAL=300
SCHEDULER_SOCIAL_INTERVAL=900
SCHEDULER_SMART_MONEY_INTERVAL=3600
SCHEDULER_AI_DIGEST_INTERVAL=3600
SCHEDULER_TREND_INTERVAL=900

# ─── Data Retention ───────────────────────────────────────────────────────────
NEWS_RETENTION_DAYS=30
SOCIAL_RETENTION_DAYS=7

# ─── Noise Filter (Level 2) ───────────────────────────────────────────────────
# Minimum engagement score (upvotes) for a Reddit post to pass the filter
NOISE_MIN_ENGAGEMENT=3.0
# Seconds window for bot-burst detection (same author, same ticker)
NOISE_BOT_BURST_WINDOW=300
# Posts within the window that trigger bot-burst rejection
NOISE_BOT_BURST_THRESHOLD=5

# ─── Signal Smoothing / Trend Intelligence (Level 2) ─────────────────────────
# EMA alpha for composite score smoothing (0=ignore current, 1=no smoothing)
TREND_SMOOTHING_ALPHA=0.3
# Dampening factor applied to tickers moving WITH a market-wide regime move
TREND_VOLATILITY_DAMPENING=0.8
# Redis TTL (seconds) for per-ticker EMA history (24h = 86400)
TREND_SMOOTHING_REDIS_TTL=86400

# ─── Level 3: Institutional Capital Flow Intelligence ────────────────────────
# Smart money lookback window for flow analysis
FLOW_ANALYSIS_WINDOW_HOURS=24
# Days of direction history to track in Redis
FLOW_PERSISTENCE_HISTORY_DAYS=7
# Strength delta (0-100) that constitutes "building" vs "fading" acceleration
FLOW_ACCELERATION_THRESHOLD=10.0

# Minimum rotation velocity delta to classify ETF as inflow/outflow
ETF_ROTATION_VELOCITY_THRESHOLD=0.05

# Minimum score delta to call a macro regime shift
MACRO_REGIME_SHIFT_THRESHOLD=0.15

# Level-3 intelligence cycle interval (seconds): runs flow + ETF + regime + confluence
SCHEDULER_INTELLIGENCE_INTERVAL=900

# ─── Level 4: Signal Validation + Backtesting Infrastructure ─────────────────
# Enable the signal validation and backtesting subsystem
VALIDATION_ENABLED=true

# Days of history to include in a full backtest run
BACKTEST_WINDOW_DAYS=30

# Days to retain signals in signals_registry (cleanup job)
SIGNAL_RETENTION_DAYS=365

# Rows per archiver poll cycle (per source table)
ARCHIVER_BATCH_SIZE=500

# Seconds between archiver poll cycles
ARCHIVER_POLL_INTERVAL=30

# Seconds between backtest evaluation cycles
BACKTEST_EVAL_INTERVAL=900

# ─── Grafana Admin Credentials ────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_STRONG_GRAFANA_PASSWORD  # [REQUIRED] — must not be blank or placeholder

# ─── Prometheus Retention ─────────────────────────────────────────────────────
PROMETHEUS_RETENTION=15d

# ─── Phase 3: Validation Intelligence + Alert Engine ─────────────────────────

# Seconds between alert check cycles (default: 900 = 15min)
ALERT_CHECK_INTERVAL=900

# Hours before the same alert type can re-fire for the same engine
ALERT_COOLDOWN_HOURS=4

# Precision drop thresholds (week-over-week fraction, e.g. 0.20 = 20%)
ALERT_PRECISION_DROP_HIGH=0.20
ALERT_PRECISION_DROP_CRITICAL=0.30

# Calibration error threshold (weighted MAE between confidence and accuracy)
ALERT_CALIBRATION_DRIFT_THRESHOLD=0.20

# False positive rate threshold (sustained over 3+ replay runs)
ALERT_FP_RATE_THRESHOLD=0.40

# Number of failed replay runs in 24h that trigger alerts
ALERT_REPLAY_FAILURE_HIGH=2
ALERT_REPLAY_FAILURE_CRITICAL=5

# Outcome coverage thresholds (fraction of signals with ≥1 outcome)
ALERT_COVERAGE_GAP_HIGH=0.40
ALERT_COVERAGE_GAP_CRITICAL=0.20

# ─── Phase 4: Adaptive Governance Layer ──────────────────────────────────────

# Seconds between governance scoring cycles (default: 3600 = 1 hour)
GOVERNANCE_INTERVAL=3600

# Days of replay history used for trust score computation
GOVERNANCE_PERIOD_DAYS=90

# ── Governance alert thresholds ─────────────────────────────────────────────

# Stability score drop (points) to trigger engine_instability_spike alert
ALERT_INSTABILITY_DROP=20.0

# Consecutive weeks an engine must be degraded to trigger recovery_failure alert
ALERT_RECOVERY_FAIL_WEEKS=4

# Acceleration in degradation velocity to trigger degradation_acceleration alert
ALERT_DEGRADATION_ACCEL=0.03

# Narrative persistence must have been above this before collapse is declared
ALERT_NARRATIVE_COLLAPSE_FROM=0.60

# Narrative persistence drops to below this (from above) = collapsing
ALERT_NARRATIVE_COLLAPSE_TO=0.45

# High-confidence accuracy must be below this for 3+ consecutive weeks
ALERT_CONFIDENCE_INCONSISTENCY=0.55

# ─── Phase 5: Meta-Intelligence + Strategic Memory Layer ─────────────────────

# Seconds between meta-intelligence cycles (default: 3600 = 1 hour)
META_INTERVAL=3600

# Days of memory window for long-term behavior analysis
META_MEMORY_WINDOW_DAYS=180

# ── Meta-intelligence alert thresholds ──────────────────────────────────────

# Minimum recurrence count to fire a recurring_historical_failure alert
ALERT_RECURRING_FAILURE_MIN=3

# Window in days to search for recurring patterns
ALERT_META_MEMORY_WINDOW_DAYS=90

# Transition instability score (0–100) to fire transition_instability_warning
ALERT_TRANSITION_INSTABILITY=15.0

# Narrative decay velocity (absolute, per week) to fire narrative_collapse_acceleration
ALERT_NARRATIVE_DECAY_VELOCITY=0.05

# Governance stress score to fire governance_stress_spike alert
ALERT_GOVERNANCE_STRESS=65.0

# Strategic instability index to fire strategic_instability_alert
ALERT_STRATEGIC_INSTABILITY=60.0

# Job Scraper
DISCORD_WEBHOOK_JOBS=
JOB_SCRAPER_SCORE_THRESHOLD=6
JOB_SCRAPER_INTERVAL=7200

# ══════════════════════════════════════════════════════════════════════════════
# ADVANCED / TUNING — all optional
# ══════════════════════════════════════════════════════════════════════════════
# Every variable below is read by the code with the default shown. They are
# commented out on purpose: leaving them alone keeps the code default, and
# uncommenting one opts you into overriding it. Values here mirror the defaults
# in the source as of this file's last update — the code is the source of truth.
#
# Several of these directly affect risk and position sizing. Read the comment
# before changing one on anything that trades real money.

# ── Position sizing & risk ────────────────────────────────────────────────────
#RISK_PCT=0.01                       # fraction of balance risked per trade
#TARGET_VOL=0.02                     # target volatility for vol-scaled sizing
#MAX_CRYPTO_TRADES=4                 # max concurrent crypto positions
#INITIAL_BALANCE=10000               # starting paper balance
#ADAPTIVE_SIZING_ENABLED=false
#PORTFOLIO_EDGE_SIZING=false
#EDGE_SCALE_ENABLED=false

# ── Stops, trails & exits ─────────────────────────────────────────────────────
#STOP_LOSS_PCT=2.0                   # equities/default stop, percent
#CRYPTO_STOP_LOSS_PCT=12.0           # crypto stop, percent
#TRAIL_ACTIVATE_PCT=0.5              # percent gain before the trail arms
#TRAIL_STOP_PCT=1.5                  # trail distance, percent
#MAX_TRAIL_ACT_PCT=0.015
#PARTIAL_T1_PCT=0.008                # first partial take-profit
#PARTIAL_T2_PCT=0.022                # second partial take-profit
#STALE_FLATTEN_S=1200                # flatten a position idle this long
#NO_MOMENTUM_HOURS=4                 # cut a position with no momentum after N hours
#NO_MOMENTUM_MIN_MFE=-0.001
#MAX_HOLD_CRYPTO_SHORT=24            # max hold, hours
#MAX_HOLD_CRYPTO_SHORT_RISK_ON=6

# ── Drawdown governor ─────────────────────────────────────────────────────────
#DD_GOVERNOR_ENABLED=true
#DD_SOFT_PCT=0.03                    # soft drawdown: reduce size
#DD_HARD_PCT=0.05                    # hard drawdown: stop opening
#DD_STOP_PCT=0.10                    # full stop
#DD_RECOVERY_RATIO=0.95
#LIVE_DAILY_LOSS_LIMIT=50.0

# ── Truth router & out-of-sample gate ─────────────────────────────────────────
# The OOS gate is what blocks most trades by design. Loosening it is how you
# end up trading signals that have not proven an edge.
#ROUTER_ENABLED=true
#ROUTER_INVERT=true
#ROUTER_MIN_EDGE=0.05
#ROUTER_MIN_N=30
#ROUTER_INVERT_MIN_EDGE=0.08
#ROUTER_INVERT_MIN_N=100
#ROUTER_CONFIRM_LONG_EDGE=0.15
#ROUTER_LOOKBACK_DAYS=30
#ROUTER_WINDOW_H=24
#ROUTER_LIFT_WINDOW_H=                # falls back to ROUTER_WINDOW_H when unset
#ROUTER_SHRINK_K=50
#ROUTER_REFRESH_S=3600
#ROUTER_MAX_STALENESS_S=86400
#ROUTER_PASSTHROUGH_POLICY=block     # what to do with unrouted signals
#OOS_GATE_ENABLED=true
#OOS_MIN_N=30
#OOS_COST=0.003
#OOS_REFRESH_S=21600
#OOS_MAX_STALENESS_S=86400
#OOS_TICKER_OVERRIDE=
#OOS_LONG_MIN_EDGE=                  # defaults to the router's MIN_EDGE

# ── Signal scoring thresholds ─────────────────────────────────────────────────
#SCORE_LONG_THRESHOLD=0.22
#SCORE_SHORT_THRESHOLD=-0.15
#CONVICTION_GATE_ENABLED=true
#MIN_NEWS_CONVICTION=0.10
#MIN_SOCIAL_CONVICTION=0.15
#MIN_VOLUME_CONVICTION=0.05
#OPP_SIGNAL_COOLDOWN_MIN=45

# ── Asset filters ─────────────────────────────────────────────────────────────
#BANNED_ASSETS=                      # comma-separated, never traded
#CRYPTO_SHORT_WHITELIST=BTC,ETH,AVAX,SOL,BNB,OP,DOGE
#CRYPTO_NOISE_GATE=0.10
#CRYPTO_CONFIRM_SKIPS_DEADZONE=false
#DISABLE_LONGS=
#DISABLE_CRYPTO_SHORTS_RISK_ON=false
#LONG_ASSET_OVERRIDE=
#REGIME_FILTER_ENABLED=false
#FUNDING_BLOCK_THRESHOLD=-0.001
#RECONCILE_IGNORE_ASSETS=BNB

# ── Live-mode notional caps (only apply when TRADING_MODE=live) ───────────────
#LIVE_MIN_NOTIONAL=10
#LIVE_MAX_NOTIONAL=15
#LIVE_MIN_NOTIONAL_PCT=0.0
#LIVE_MAX_NOTIONAL_PCT=0.0
#LIVE_PILOT_FADES_ONLY=true          # live pilot trades fades only
#LIVE_CONFIRM_TICKERS=
#LIVE_CRYPTO_SHORT_WHITELIST=

# ── Broker execution ──────────────────────────────────────────────────────────
#BINANCE_FUTURES=true
#BINANCE_FUTURES_LEVERAGE=1
#MAKER_ENTRY=true
#MAKER_WAIT_SEC=12
#MAKER_EXIT=true
#MAKER_EXIT_WAIT_SEC=10

# ── Engine loop intervals (seconds) ───────────────────────────────────────────
#PAPER_TRADING_POLL_INTERVAL=30
#OUTCOME_EVAL_INTERVAL=300
#SCORER_INTERVAL=3600
#SCORER_PERIOD_DAYS=30
#SCORER_MIN_SAMPLES=20
#REPLAY_POLL_INTERVAL=5
#REPLAY_AUTO_SCHEDULE=true
#EVAL_INTERVAL=900
#AGGREGATOR_INTERVAL=3600
#ALERT_INSTABILITY_COOLDOWN_HOURS=24.0
#EDGE_ANALYZER_OUTCOME_INTERVAL=300
#EDGE_ANALYZER_METRICS_INTERVAL=3600
#EDGE_ANALYZER_AGGREGATION_INTERVAL=86400
#EDGE_ANALYZER_WALKFORWARD_INTERVAL=86400
#EDGE_ANALYZER_WEEKLY_INTERVAL=604800
#EDGE_ANALYZER_LESSONS_INTERVAL=604800
#EDGE_ANALYZER_CLAUDE_MD_INTERVAL=1800
#EDGE_ANALYZER_HEALTH_INTERVAL=30
#EDGE_HEALTH_MAX_FAILURES=3
#EDGE_HEALTH_RESTART_COOLDOWN=3600
#META_STRATEGY_ENABLED=false
#META_STRATEGY_INTERVAL=1800
#FREETIME_LOAD_THRESHOLD=3.0

# ── Internal metrics ports (container-side; change only on a conflict) ────────
#BACKTEST_HTTP_PORT=8011
#ARCHIVER_HTTP_PORT=8012
#OUTCOME_HTTP_PORT=8013
#SCORER_HTTP_PORT=8014
#REPLAY_HTTP_PORT=8015
#ALERT_HTTP_PORT=8016
#GOVERNANCE_HTTP_PORT=8017
