#OLLAMA_NEWS_MODEL=qwen2.5:3b
#LLM_AUDIT_ENABLED=true
#LLM_AUDIT_MODEL=qwen2.5:7b
#LLM_AUDIT_TIMEOUT_S=180
#LLM_POSTMORTEM_MODEL=qwen2.5:3b
#CLAUDE_MD_PATH=/workspace/architecture.md

# ── Discord webhooks (optional, separate from the bot token) ──────────────────
#DISCORD_WEBHOOK_TRADES=
#DISCORD_WEBHOOK_PAPER_TRADES=
#DISCORD_WEBHOOK_ALERTS=
#DISCORD_WEBHOOK_WATCHDOG=
#DISCORD_WEBHOOK_JOURNAL=
#DISCORD_WEBHOOK_DAILY_BRIEF=
#DISCORD_WEBHOOK_ENV=DISCORD_WEBHOOK_TRADES   # which webhook var the notifier reads

# ── Misc ──────────────────────────────────────────────────────────────────────
#ENABLE_CACHE=true
#CACHE_TTL_SECONDS=300
#CORS_ALLOWED_ORIGINS=http://localhost:3001
#VALIDATION_API_BASE=http://validation-api:8010
#WATCHDOG_IGNORE_CONTAINERS=freetime-researcher
#ENGINE_REDIS_PREFIX=
