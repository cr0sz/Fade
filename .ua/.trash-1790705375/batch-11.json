      "filePath": "scripts/governance_engine.py",
      "summary": "Applies governance actions derived from LLM lessons to the trading system via Redis (strategy exclusions, dynamic bans), environment file updates (threshold adjustments), database audit logging, and Discord notifications with dry-run support.",
      "tags": ["governance", "trading-safety", "multi-target-sync", "audit-logging"],
      "complexity": "moderate",
      "languageNotes": "Uses asyncpg for database, aioredis for cache, regex for .env file manipulation. Protected engine list prevents accidental halting (Sprint 34 incident)."
    },
